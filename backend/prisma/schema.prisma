generator client {
  provider        = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  schemas  = ["attendance_app"]
}

enum Role {
  ADMIN
  EMPLOYEE

  @@schema("attendance_app")
}

enum OvertimeStatus {
  NONE
  PENDING
  APPROVED
  REJECTED

  @@schema("attendance_app")
}

model User {
  id           String       @id @default(uuid())
  name         String
  email        String       @unique
  password     String
  role         Role         @default(EMPLOYEE)
  baseSalary   Float        @default(0.0)
  overtimeRate Float        @default(150.0)
  isActive     Boolean      @default(true) // Set to false to disband/ban user
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  attendances  Attendance[]

  @@schema("attendance_app")
}

model Attendance {
  id             String         @id @default(uuid())
  userId         String
  user           User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  date           DateTime       @default(now())
  inTime         DateTime       @default(now())
  outTime        DateTime?
  workingHours   Float?
  task           String?
  assignedTask   String?
  overtimeHours  Float?         @default(0.0)
  overtimeStatus OvertimeStatus @default(NONE)
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  @@index([userId, date])
  @@schema("attendance_app")
}

model Holiday {
  id        String   @id @default(uuid())
  title     String
  date      DateTime @unique
  createdAt DateTime @default(now())

  @@schema("attendance_app")
}