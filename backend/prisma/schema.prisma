generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["multiSchema"]
}

datasource db {
  provider = "postgresql"
  schemas  = ["attendance_app"]
}

enum Role {
  ADMIN
  EMPLOYEE

  @@schema("attendance_app")
}

enum OvertimeStatus {
  NONE
  PENDING
  APPROVED
  REJECTED

  @@schema("attendance_app")
}

model User {
  id          String       @id @default(uuid())
  name        String
  email       String       @unique
  password    String
  role        Role         @default(EMPLOYEE)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  attendances Attendance[]

  @@schema("attendance_app")
}

model Attendance {
  id             String         @id @default(uuid())
  userId         String
  user           User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  date           DateTime       @default(now())
  inTime         DateTime       @default(now())
  outTime        DateTime?
  workingHours   Float?
  task           String?
  assignedTask   String?
  overtimeHours  Float?         @default(0.0)
  overtimeStatus OvertimeStatus @default(NONE)
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  @@index([userId, date])
  @@schema("attendance_app")
}